)&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="c232"><mxGeometry y="206" width="330" height="22" as="geometry"/></mxCell><mxCell id="title" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;Sistema de Gestión para Carpintería — Diagrama Entidad-Relación&lt;/b&gt;&lt;br&gt;Notación pata de gallo · 3FN · 29 tablas · Modelo de datos v1.3" style="text;html=1;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="70" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Referencias&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria · &lt;b&gt;FK&lt;/b&gt; clave foránea (en cursiva)&lt;br&gt;&lt;i&gt;(opcional)&lt;/i&gt; = admite nulo&lt;br&gt;&lt;br&gt;&lt;b&gt;Cardinalidad&lt;/b&gt;&lt;br&gt;│ ─ una y solo una (FK obligatoria)&lt;br&gt;○ ─ cero o una (FK opcional)&lt;br&gt;○&amp;lt; cero o muchas&lt;br&gt;&lt;br&gt;La etiqueta de cada línea es la FK que la implementa.&lt;br&gt;&lt;br&gt;&lt;b&gt;Áreas&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;background:#f5f5f5;border:1px solid #666666&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Seguridad y configuración&lt;br&gt;&lt;span style=&#x27;background:#dae8fc;border:1px solid #6c8ebf&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Clientes y trabajos&lt;br&gt;&lt;span style=&#x27;background:#d5e8d4;border:1px solid #82b366&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Estructura del mueble&lt;br&gt;&lt;span style=&#x27;background:#d0f0ee;border:1px solid #3d9991&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Guías de cajón&lt;br&gt;&lt;span style=&#x27;background:#e1d5e7;border:1px solid #9673a6&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Despiece&lt;br&gt;&lt;span style=&#x27;background:#ffe6cc;border:1px solid #d79b00&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Materiales&lt;br&gt;&lt;span style=&#x27;background:#f8cecc;border:1px solid #b85450&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp;Inventario&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ffffff;strokeColor=#999999;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="2740" y="632" width="330" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
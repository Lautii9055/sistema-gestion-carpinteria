# =============================================================================
#  SEGURIDAD: nunca subir secretos ni datos reales
# =============================================================================
# Archivos con contraseñas, claves o configuración local
.env
.env.*
*.secret
*.key
*.pem
*.pfx
config.local.*
secrets/
credenciales*
contrase*
contrac*

# Copias de seguridad de la base (contienen datos de clientes)
*.bak
*.bak.enc
*.sha256
backups/

# Logs de la aplicación (pueden contener datos de uso)
logs/
*.log

# Listados de corte y exportaciones generadas
salidas/
*.generado.pdf

# =============================================================================
#  PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Entornos virtuales
.venv/
venv/
env/

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/

# Flet
storage/

# =============================================================================
#  EDITOR Y SISTEMA OPERATIVO
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Temporales de draw.io
*.drawio.bkp
*.drawio.dtmp
